#
# Generated files (linguist-generated): GitHub collapses them in a pull
# request's diff, and factory/review leaves them out of the review and of
# the diff its reviewers read (HFL-810). Every path here is written by a
# generator, and task check fails when it differs from a regeneration;
# never list a hand-written file. hack/check-generated-attrs.sh holds both
# directions: every file with a generator's header is listed, and nothing
# under the hand-written paths is.

# ASO's generator (hack/generate-arm.sh) and controller-gen (hack/generate.sh)
*_gen.go                       linguist-generated=true
*_gen_test.go                  linguist-generated=true
zz_generated.*                 linguist-generated=true
apis/**/doc.go                 linguist-generated=true
apis/**/structure.txt          linguist-generated=true
apis/**/versions_matrix.md     linguist-generated=true
config/crds/**                 linguist-generated=true
config/test/aso-crds/**        linguist-generated=true
generator/reports/**           linguist-generated=true

# The coverage dashboard (hack/coverage/run.sh; coverage-check). Its
# README and the other hand-written files there are not listed.
docs/coverage/services.csv     linguist-generated=true
docs/coverage/resources.csv    linguist-generated=true
docs/coverage/attributes.csv   linguist-generated=true
docs/coverage/attributes/**    linguist-generated=true
docs/coverage/tiers.csv        linguist-generated=true
docs/coverage/categories.csv   linguist-generated=true
docs/coverage/bars/**          linguist-generated=true

# The Upjet facts, written by the factory (factory upjet sync)
hack/upjet/*.json              linguist-generated=true
