+
+// Modified by High Five Labs: a property marked for flattening whose type
+// has no definition here (free-form JSON) is kept, not flattened, instead
+// of recursing until the stack overflows.
+func TestFlattenProperties_ExternalType_KeepsProperty(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_FLATTEN_EXTERNAL", "1")
+	g := NewGomegaWithT(t)
+
+	free := astmodel.NewPropertyDefinition("TypeProperties", "typeProperties", astmodel.JSONType).SetFlatten(true)
+	name := astmodel.NewPropertyDefinition("Name", "name", astmodel.StringType)
+	objType := astmodel.NewObjectType().WithProperties(name, free)
+
+	defs := make(astmodel.TypeDefinitionSet)
+	defs.Add(astmodel.MakeTypeDefinition(astmodel.MakeInternalTypeName(placeholderPackage, "LinkedService"), objType))
+
+	result, err := FlattenProperties(logr.Discard()).Run(context.Background(), NewState(defs))
+	g.Expect(err).ToNot(HaveOccurred())
+
+	expected := astmodel.NewObjectType().WithProperties(name, free.SetFlatten(false))
+	g.Expect(result.Definitions()[astmodel.MakeInternalTypeName(placeholderPackage, "LinkedService")].Type()).To(Equal(expected))
+}
