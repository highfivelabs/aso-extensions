+// isListedFixedName reports whether "type/child/name" (sites/config/logs) is
+// listed in ASO_GENERATOR_FIXED_NAMES (comma separated, case insensitive): a
+// child resource whose instances have fixed names, each generated as its own
+// resource (Modified by High Five Labs).
+func isListedFixedName(path string) bool {
+	for _, entry := range strings.Split(os.Getenv("ASO_GENERATOR_FIXED_NAMES"), ",") {
+		if entry = strings.TrimSpace(entry); entry != "" && strings.EqualFold(entry, path) {
+			return true
+		}
+	}
+
+	return false
+}
