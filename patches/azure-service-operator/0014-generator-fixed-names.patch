+package jsonast
+
+import (
+	"testing"
+
+	. "github.com/onsi/gomega"
+
+	"github.com/Azure/azure-service-operator/v2/tools/generator/internal/astmodel"
+)
+
+// Modified by High Five Labs: a fixed name listed in ASO_GENERATOR_FIXED_NAMES
+// (sites/config/logs) names its own resource of the parent path's ARM type;
+// one not listed is refused as before.
+func Test_inferNameFromURLPath_FixedNames(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_FIXED_NAMES", "sites/config/logs, sites/basicPublishingCredentialsPolicies/ftp")
+	g := NewGomegaWithT(t)
+	extractor := &SwaggerTypeExtractor{idFactory: astmodel.NewIdentifierFactory()}
+	base := "/subscriptions/{subscriptionId}/resourceGroups/{resourceGroupName}/providers/Microsoft.Web/sites/{name}/"
+
+	group, resource, name, err := extractor.inferNameFromURLPath(base + "config/logs")
+	g.Expect(err).ToNot(HaveOccurred())
+	g.Expect(group).To(Equal("Microsoft.Web"))
+	g.Expect(resource).To(Equal("sites/config"))
+	g.Expect(name).To(Equal("Sites_Config_Log"))
+
+	_, resource, name, err = extractor.inferNameFromURLPath(base + "basicPublishingCredentialsPolicies/FTP")
+	g.Expect(err).ToNot(HaveOccurred())
+	g.Expect(resource).To(Equal("sites/basicPublishingCredentialsPolicies"))
+	g.Expect(name).To(Equal("Sites_BasicPublishingCredentialsPolicies_FTP"))
+
+	_, _, _, err = extractor.inferNameFromURLPath(base + "config/backup")
+	g.Expect(err).To(MatchError(ContainSubstring("unexpected hard coded name")))
+
+	// A listed name in the middle of a path is not a fixed name.
+	_, _, _, err = extractor.inferNameFromURLPath(base + "config/logs/list")
+	g.Expect(err).To(HaveOccurred())
+
+	// config/web stays as it was.
+	_, resource, name, err = extractor.inferNameFromURLPath(base + "config/web")
+	g.Expect(err).ToNot(HaveOccurred())
+	g.Expect(resource).To(Equal("sites/config"))
+	g.Expect(name).To(Equal("Sites_Config"))
+}
