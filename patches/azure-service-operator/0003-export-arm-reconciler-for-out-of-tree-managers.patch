+++ b/v2/pkg/outoftree/extensions.go
@@ -0,0 +1,38 @@
+/*
+Copyright (c) Microsoft Corporation.
+Licensed under the MIT license.
+*/
+
+// Modified by High Five Labs: this file is new. It exports, unchanged, what
+// a hand-written extension of an out-of-tree generated kind needs and ASO
+// keeps in v2/internal/: the ARM client an ARMResourceModifier receives, the
+// reflection helper ASO's role extensions set a property with, and the UUID
+// naming ASO's role webhooks default a name with.
+
+package outoftree
+
+import (
+	"github.com/Azure/azure-service-operator/v2/internal/genericarmclient"
+	"github.com/Azure/azure-service-operator/v2/internal/reflecthelpers"
+	"github.com/Azure/azure-service-operator/v2/internal/util/randextensions"
+)
+
+// GenericClient is ASO's ARM client, as extensions.ARMResourceModifier
+// receives it.
+type GenericClient = genericarmclient.GenericClient
+
+// SetProperty sets a property of an object by its dotted path, by
+// reflection (reflecthelpers.SetProperty).
+var SetProperty = reflecthelpers.SetProperty
+
+var (
+	// MakeUUIDName is a UUID (v5) from a unique string, or name when it is
+	// a UUID already (randextensions.MakeUUIDName).
+	MakeUUIDName = randextensions.MakeUUIDName
+	// MakeUniqueOwnerScopedString is the string ASO makes a stable UUID
+	// from: owner, group, kind, namespace and name
+	// (randextensions.MakeUniqueOwnerScopedString).
+	MakeUniqueOwnerScopedString = randextensions.MakeUniqueOwnerScopedString
+	// MakeRandomUUID is a new random UUID (randextensions.MakeRandomUUID).
+	MakeRandomUUID = randextensions.MakeRandomUUID
+)
