+/*
+ * Copyright (c) Microsoft Corporation.
+ * Licensed under the MIT license.
+ */
+
+// Modified by High Five Labs: a new test of the spec initialization scanner
+// on a type that holds itself.
+
+package pipeline
+
+import (
+	"testing"
+
+	. "github.com/onsi/gomega"
+
+	"github.com/Azure/azure-service-operator/v2/tools/generator/internal/astmodel"
+	"github.com/Azure/azure-service-operator/v2/tools/generator/internal/config"
+)
+
+func TestSpecInitializationScanner_RecursiveType_VisitsOnce(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_SPEC_INIT_CYCLES", "1")
+	g := NewGomegaWithT(t)
+
+	spec := astmodel.MakeInternalTypeName(placeholderPackage, "Activity")
+	status := astmodel.MakeInternalTypeName(placeholderPackage, "Activity_STATUS")
+	defs := make(astmodel.TypeDefinitionSet)
+	defs.Add(astmodel.MakeTypeDefinition(spec, astmodel.NewObjectType().WithProperties(
+		astmodel.NewPropertyDefinition("Activities", "activities", astmodel.NewArrayType(spec)))))
+	defs.Add(astmodel.MakeTypeDefinition(status, astmodel.NewObjectType().WithProperties(
+		astmodel.NewPropertyDefinition("Activities", "activities", astmodel.NewArrayType(status)))))
+
+	scanner := newSpecInitializationScanner(defs, nil, config.NewConfiguration())
+	_, err := scanner.visitor.Visit(spec, status)
+	g.Expect(err).ToNot(HaveOccurred())
+	g.Expect(scanner.specToStatus[spec].Contains(status)).To(BeTrue())
+}
