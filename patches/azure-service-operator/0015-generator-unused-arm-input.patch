+
+// usesIdent reports whether any of the statements refers to the identifier
+// name (Modified by High Five Labs).
+func usesIdent(stmts []dst.Stmt, name string) bool {
+	found := false
+	for _, stmt := range stmts {
+		dst.Inspect(stmt, func(n dst.Node) bool {
+			if id, ok := n.(*dst.Ident); ok && id.Name == name {
+				found = true
+			}
+			return !found
+		})
+		if found {
+			return true
+		}
+	}
+
+	return false
+}
