+// isSubscriptionScope is whether armURI is
+// /subscriptions/{subscriptionId}/providers/{namespace}/{type}/{name}: one
+// resource, kept directly under a subscription.
+func isSubscriptionScope(armURI string) bool {
+	parts := strings.Split(strings.Trim(armURI, "/"), "/")
+	return len(parts) == 6 && strings.EqualFold(parts[0], "subscriptions") && strings.EqualFold(parts[2], "providers")
+}
