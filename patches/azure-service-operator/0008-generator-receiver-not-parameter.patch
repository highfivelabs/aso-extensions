 // (e.g. a type ending in "Storage" yields receiver "storage", clashing with the storage subpackage alias).
 var forbiddenReceiverNames = set.Make(strings.ToLower(ARMPackageName), strings.ToLower(StoragePackageName))
 
+// Modified by High Five Labs: with ASO_GENERATOR_RECEIVER_NOT_PARAMETER set,
+// a receiver may not be named after the parameter of a generated conversion
+// function either ("source" or "destination"): a type ending in "Source"
+// (Log Analytics' Workspaces_DataSource) yielded receiver "source", which
+// the AssignProperties_From_... parameter then shadowed, and the storage
+// conversions did not compile.
+func isForbiddenReceiverName(lowerBase string) bool {
+	if forbiddenReceiverNames.Contains(lowerBase) {
+		return true
+	}
+
+	return os.Getenv("ASO_GENERATOR_RECEIVER_NOT_PARAMETER") != "" && (lowerBase == "source" || lowerBase == "destination")
+}
