+
+// Modified by High Five Labs: with ASO_GENERATOR_RECEIVER_NOT_PARAMETER set,
+// a receiver is named after neither a conversion function's parameter nor
+// the schema package nor a Go predeclared identifier.
+func Test_CreateReceiver_NotParameter_ReturnsQualifiedName(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_RECEIVER_NOT_PARAMETER", "1")
+
+	cases := []struct {
+		name     string
+		expected string
+	}{
+		{"Workspaces_DataSource" + SpecSuffix, "dataSource"},
+		{"ExportDeliveryDestination", "deliveryDestination"},
+		{"Service_Apis_Schema" + SpecSuffix, "apisSchema"},
+		{"SecureString", "secureString"},
+		{"SecureString" + StatusSuffix, "secureString"},
+		{"Address", "address"},
+	}
+
+	factory := NewIdentifierFactory()
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			g := NewGomegaWithT(t)
+			g.Expect(factory.CreateReceiver(c.name)).To(Equal(c.expected))
+		})
+	}
+}
