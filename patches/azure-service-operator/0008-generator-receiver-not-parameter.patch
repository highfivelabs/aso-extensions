@@ -6,6 +6,7 @@
 package astmodel
 
 import (
+	"os"
 	"regexp"
 	"strings"
 	"sync"
@@ -238,7 +239,7 @@ func (factory *identifierFactory) CreateReceiver(name string) string {
 	if len(words) > 1 {
 		lowerBase := strings.ToLower(base)
 		_, reserved := factory.reservedWords[lowerBase]
-		if reserved || len(base) <= 3 || forbiddenReceiverNames.Contains(lowerBase) {
+		if reserved || len(base) <= 3 || isForbiddenReceiverName(lowerBase) {
 			base = words[len(words)-2] + base
 		}
 	}
@@ -303,6 +304,34 @@ func createForbiddenReceiverSuffixes() set.Set[string] {
 // (e.g. a type ending in "Storage" yields receiver "storage", clashing with the storage subpackage alias).
 var forbiddenReceiverNames = set.Make(strings.ToLower(ARMPackageName), strings.ToLower(StoragePackageName))
 
+// Modified by High Five Labs: with ASO_GENERATOR_RECEIVER_NOT_PARAMETER set,
+// a receiver may not be named after the parameter of a generated conversion
+// function ("source", "destination": Log Analytics' Workspaces_DataSource
+// yielded "source", which the AssignProperties_From_... parameter shadowed)
+// or after the "schema" package a resource's methods use (API Management's
+// Service_Apis_Schema yielded "schema"), nor (2026-11-24) after a Go
+// predeclared identifier the generated code uses (Synapse's SecureString
+// yielded "string", which shadowed the type): the generated code did not
+// compile.
+func isForbiddenReceiverName(lowerBase string) bool {
+	if forbiddenReceiverNames.Contains(lowerBase) {
+		return true
+	}
+
+	if os.Getenv("ASO_GENERATOR_RECEIVER_NOT_PARAMETER") == "" {
+		return false
+	}
+
+	return lowerBase == "source" || lowerBase == "destination" || lowerBase == "schema" || predeclaredIdentifiers.Contains(lowerBase)
+}
+
+// predeclaredIdentifiers are Go's predeclared types and functions, which
+// generated method bodies use (Modified by High Five Labs).
+var predeclaredIdentifiers = set.Make(
+	"any", "bool", "byte", "error", "float32", "float64", "int", "int8", "int16", "int32", "int64",
+	"rune", "string", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr",
+	"append", "cap", "copy", "delete", "len", "make", "new", "panic")
+
 func (factory *identifierFactory) CreateGroupName(group string) string {
 	return strings.TrimPrefix(strings.ToLower(group), "microsoft.")
 }
