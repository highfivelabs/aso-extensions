diff --git a/v2/tools/generator/internal/interfaces/cel_validations_test.go b/v2/tools/generator/internal/interfaces/cel_validations_test.go
new file mode 100644
index 0000000..2ea235f
--- /dev/null
+++ b/v2/tools/generator/internal/interfaces/cel_validations_test.go
@@ -0,0 +1,41 @@
+/*
+ * Copyright (c) Microsoft Corporation.
+ * Licensed under the MIT license.
+ */
+
+package interfaces
+
+import (
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+)
+
+// Modified by High Five Labs: the CEL markers ASO_GENERATOR_CEL_VALIDATIONS
+// adds, one per write-once property the spec has.
+func Test_CELValidationAnnotations(t *testing.T) {
+	t.Parallel()
+	g := NewGomegaWithT(t)
+
+	g.Expect(CELValidationAnnotations(false, false)).To(BeEmpty())
+
+	both := CELValidationAnnotations(true, true)
+	g.Expect(both).To(HaveLen(2))
+	for _, a := range both {
+		g.Expect(a).To(HavePrefix("// +kubebuilder:validation:XValidation:rule="))
+		g.Expect(strings.Count(a, `"`) % 2).To(Equal(0))
+	}
+	g.Expect(both[0]).To(ContainSubstring("self.spec.owner == oldSelf.spec.owner"))
+	g.Expect(both[0]).To(ContainSubstring(`fieldPath=".spec.owner"`))
+	g.Expect(both[1]).To(ContainSubstring("self.spec.azureName == oldSelf.spec.azureName"))
+	g.Expect(both[1]).To(ContainSubstring("size(oldSelf.spec.azureName) == 0"))
+
+	ownerOnly := CELValidationAnnotations(true, false)
+	g.Expect(ownerOnly).To(HaveLen(1))
+	g.Expect(ownerOnly[0]).To(ContainSubstring("spec.owner"))
+
+	nameOnly := CELValidationAnnotations(false, true)
+	g.Expect(nameOnly).To(HaveLen(1))
+	g.Expect(nameOnly[0]).To(ContainSubstring("spec.azureName"))
+}
