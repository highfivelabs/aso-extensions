 	result := astmodel.MakeTypeDefinitionSetFromDefinitions(
 		updatedResource,
 		specDef,
@@ -775,3 +790,23 @@ func getStringAzureNameWithAnnotationFallbackFunction(
 	fn.AddReturns("string")
 	return fn.DefineFunc(), nil
 }
+
+// CELValidationAnnotations returns the kubebuilder markers of the CEL rules a
+// resource gets for ASO_GENERATOR_CEL_VALIDATIONS (Modified by High Five
+// Labs): spec.owner cannot change once set, and spec.azureName cannot change
+// once set to a non-empty value (ASO lets an empty one be set, as its webhook
+// does, #4306). Unlike ASO's webhook, both hold from the first update, not
+// only after the resource was created in Azure: CEL cannot read the
+// annotation that records that.
+func CELValidationAnnotations(hasOwner bool, hasAzureName bool) []string {
+	var result []string
+	if hasOwner {
+		result = append(result,
+			`// +kubebuilder:validation:XValidation:rule="!has(oldSelf.spec) || !has(oldSelf.spec.owner) || (has(self.spec) && has(self.spec.owner) && self.spec.owner == oldSelf.spec.owner)",message="spec.owner cannot be changed or removed; delete the object and create it again",fieldPath=".spec.owner",reason=FieldValueForbidden`)
+	}
+	if hasAzureName {
+		result = append(result,
+			`// +kubebuilder:validation:XValidation:rule="!has(oldSelf.spec) || !has(oldSelf.spec.azureName) || size(oldSelf.spec.azureName) == 0 || (has(self.spec) && has(self.spec.azureName) && self.spec.azureName == oldSelf.spec.azureName)",message="spec.azureName cannot be changed or removed once set; delete the object and create it again",fieldPath=".spec.azureName",reason=FieldValueForbidden`)
+	}
+	return result
+}
