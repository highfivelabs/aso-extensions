+// isExtensionChild is whether armURI is an extension resource's path (an
+// arbitrary scope prefix, or more than one /providers/ segment) whose part
+// after the last /providers/{namespace}/ has more than one {type}/{name} pair.
+func isExtensionChild(armURI string) bool {
+	lower := strings.ToLower(armURI)
+	extension := strings.Count(lower, "/providers/") > 1
+	for _, prefix := range append([]string{"/{resourceid}/", "/{scopeid}/"}, extensionScopePrefixes...) {
+		if strings.HasPrefix(lower, strings.ToLower(prefix)) {
+			extension = true
+		}
+	}
+	if !extension {
+		return false
+	}
+	i := strings.LastIndex(lower, "/providers/")
+	parts := strings.Split(strings.Trim(armURI[i+len("/providers/"):], "/"), "/")
+	// namespace, type, name, type, name, ...
+	return len(parts) >= 5 && len(parts)%2 == 1
+}
