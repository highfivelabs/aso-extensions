+ * Licensed under the MIT license.
+ */
+
+// Modified by High Five Labs: a new test of a named target from a property
+// of no named type (ASO_GENERATOR_NAMED_TARGET_FROM_ANY).
+
+package config_test
+
+import (
+	"testing"
+
+	. "github.com/onsi/gomega"
+
+	"github.com/Azure/azure-service-operator/v2/tools/generator/internal/astmodel"
+	"github.com/Azure/azure-service-operator/v2/tools/generator/internal/config"
+)
+
+// A property of type any (Data Factory's connection string) given a named
+// target (SecretBase) becomes that type in the package of the type holding
+// the property; a primitive target is still a primitive.
+func TestTransformDefinition_NamedTargetFromAny(t *testing.T) {
+	g := NewGomegaWithT(t)
+	holder := student2019
+	def := astmodel.MakeTypeDefinition(holder, astmodel.NewObjectType().WithProperties(
+		astmodel.NewPropertyDefinition("ConnectionString", "connectionString", astmodel.NewOptionalType(astmodel.AnyType))))
+	transformer := func(target string) config.TypeTransformer {
+		return config.TypeTransformer{
+			TypeMatcher: config.TypeMatcher{Name: config.NewFieldMatcher("student")},
+			Property:    config.NewFieldMatcher("ConnectionString"),
+			Target:      &config.TransformResult{Name: config.NewFieldMatcher(target), Optional: true},
+		}
+	}
+	propertyType := func(d astmodel.TypeDefinition) astmodel.Type {
+		ot, ok := astmodel.AsObjectType(d.Type())
+		g.Expect(ok).To(BeTrue())
+		prop, ok := ot.Property("ConnectionString")
+		g.Expect(ok).To(BeTrue())
+		return prop.PropertyType()
+	}
+
+	// Upstream refuses it.
+	t.Setenv("ASO_GENERATOR_NAMED_TARGET_FROM_ANY", "")
+	tr := transformer("SecretBase")
+	_, err := tr.TransformDefinition(def)
+	g.Expect(err).To(MatchError(ContainSubstring("expected InternalTypeName")))
+
+	t.Setenv("ASO_GENERATOR_NAMED_TARGET_FROM_ANY", "1")
+	tr = transformer("SecretBase")
+	result, err := tr.TransformDefinition(def)
+	g.Expect(err).ToNot(HaveOccurred())
+	g.Expect(propertyType(result)).To(Equal(astmodel.NewOptionalType(holder.WithName("SecretBase"))))
+
+	tr = transformer("string")
+	result, err = tr.TransformDefinition(def)
+	g.Expect(err).ToNot(HaveOccurred())
+	g.Expect(propertyType(result)).To(Equal(astmodel.OptionalStringType))
+}
