+// namedTargetOriginal returns the type a property's transformation starts from
+// (Modified by High Five Labs). With ASO_GENERATOR_NAMED_TARGET_FROM_ANY set,
+// a target naming a type (not a primitive) from a property whose type is not
+// a named type (such as any, a Data Factory property that takes a string, an
+// expression or a secret) is the type of that name in the package of the
+// type holding the property, or in the group and version the target gives;
+// upstream refuses it ("expected InternalTypeName"). Otherwise the property's
+// own type, as upstream.
+func (tr *TransformResult) namedTargetOriginal(holder astmodel.InternalTypeName, original astmodel.Type) astmodel.Type {
+	if os.Getenv("ASO_GENERATOR_NAMED_TARGET_FROM_ANY") == "" || tr == nil || !tr.Name.IsRestrictive() {
+		return original
+	}
+
+	if _, ok := astmodel.AsInternalTypeName(original); ok {
+		return original
+	}
+
+	if !tr.Group.IsRestrictive() && !tr.Version.IsRestrictive() {
+		if _, err := tr.asPrimitiveType(tr.Name.String()); err == nil {
+			return original
+		}
+	}
+
+	return holder
+}
