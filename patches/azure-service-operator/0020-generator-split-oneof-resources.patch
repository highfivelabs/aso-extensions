index 0000000..825727b
--- /dev/null
+++ b/v2/tools/generator/internal/codegen/pipeline/split_oneof_resources_test.go
@@ -0,0 +1,121 @@
+/*
+ * Copyright (c) Microsoft Corporation.
+ * Licensed under the MIT license.
+ */
+
+// Modified by High Five Labs: a new test of the stage that splits a
+// resource into one resource per member of a OneOf (ASO_GENERATOR_SPLIT_ONEOF).
+
+package pipeline
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+
+	"github.com/Azure/azure-service-operator/v2/tools/generator/internal/astmodel"
+	"github.com/Azure/azure-service-operator/v2/tools/generator/internal/test"
+)
+
+// A resource Person whose spec and status hold a Pet, a OneOf of Cat and Dog.
+func splitOneOfDefinitions() (astmodel.TypeDefinitionSet, astmodel.TypeDefinition) {
+	name := func(n string) astmodel.InternalTypeName { return astmodel.MakeInternalTypeName(placeholderPackage, n) }
+	object := func(n string, props ...*astmodel.PropertyDefinition) astmodel.TypeDefinition {
+		return astmodel.MakeTypeDefinition(name(n), astmodel.NewObjectType().WithProperties(props...))
+	}
+	oneOf := func(n string, members ...string) astmodel.TypeDefinition {
+		ot := astmodel.NewObjectType()
+		for _, m := range members {
+			ot = ot.WithProperties(astmodel.NewPropertyDefinition(astmodel.PropertyName(m), m, astmodel.NewOptionalType(name(m+suffixOf(n)))))
+		}
+
+		return astmodel.MakeTypeDefinition(name(n), astmodel.OneOfFlag.ApplyTo(ot))
+	}
+	kind := astmodel.NewPropertyDefinition("Kind", "kind", astmodel.StringType)
+	defs := make(astmodel.TypeDefinitionSet)
+	spec := object("Person_Spec",
+		astmodel.NewPropertyDefinition("Name", "name", astmodel.StringType),
+		astmodel.NewPropertyDefinition("Properties", "properties", astmodel.NewOptionalType(name("Pet"))))
+	status := object("Person_STATUS",
+		astmodel.NewPropertyDefinition("Properties", "properties", astmodel.NewOptionalType(name("Pet_STATUS"))))
+	defs.AddAll(spec, status,
+		oneOf("Pet", "Cat", "Dog"), oneOf("Pet_STATUS", "Cat", "Dog"),
+		object("Cat", kind), object("Dog", kind), object("Cat_STATUS", kind), object("Dog_STATUS", kind))
+	resource := test.CreateResource(placeholderPackage, "Person", spec, status)
+	resource = resource.WithType(astmodel.MustBeResourceType(resource.Type()).WithARMType("Microsoft.Pets/people"))
+	defs.Add(resource)
+
+	return defs, resource
+}
+
+// suffixOf is the suffix of a status type's name ("_STATUS"), or "".
+func suffixOf(n string) string {
+	if strings.HasSuffix(n, astmodel.StatusSuffix) {
+		return astmodel.StatusSuffix
+	}
+
+	return ""
+}
+
+func TestSplitOneOfResources_OneResourcePerMember(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_SPLIT_ONEOF", "group/Person.Properties")
+	g := NewGomegaWithT(t)
+	defs, original := splitOneOfDefinitions()
+
+	state, err := SplitOneOfResources().Run(context.TODO(), NewState(defs))
+	g.Expect(err).ToNot(HaveOccurred())
+	out := state.Definitions()
+
+	g.Expect(out.Contains(original.Name())).To(BeTrue(), "the original resource is kept")
+	for _, member := range []string{"Cat", "Dog"} {
+		name := astmodel.MakeInternalTypeName(placeholderPackage, "Person_"+member)
+		def, ok := out[name]
+		g.Expect(ok).To(BeTrue(), "resource %s", name)
+		rsrc := astmodel.MustBeResourceType(def.Type())
+		g.Expect(rsrc.ARMType()).To(Equal("Microsoft.Pets/people"))
+
+		info, err := out.ResolveResourceSpecAndStatus(def)
+		g.Expect(err).ToNot(HaveOccurred())
+		g.Expect(info.SpecDef.Name().Name()).To(Equal("Person_" + member + "_Spec"))
+		g.Expect(info.StatusDef.Name().Name()).To(Equal("Person_" + member + "_STATUS"))
+
+		prop, ok := info.SpecType.Property("Properties")
+		g.Expect(ok).To(BeTrue())
+		tn, ok := astmodel.AsInternalTypeName(prop.PropertyType())
+		g.Expect(ok).To(BeTrue())
+		g.Expect(tn.Name()).To(Equal(member))
+		_, ok = info.SpecType.Property("Name")
+		g.Expect(ok).To(BeTrue(), "the other properties of the spec are kept")
+
+		prop, ok = info.StatusType.Property("Properties")
+		g.Expect(ok).To(BeTrue())
+		tn, ok = astmodel.AsInternalTypeName(prop.PropertyType())
+		g.Expect(ok).To(BeTrue())
+		g.Expect(tn.Name()).To(Equal(member + "_STATUS"))
+	}
+}
+
+func TestSplitOneOfResources_UnsetChangesNothing(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_SPLIT_ONEOF", "")
+	g := NewGomegaWithT(t)
+	defs, _ := splitOneOfDefinitions()
+
+	state, err := SplitOneOfResources().Run(context.TODO(), NewState(defs))
+	g.Expect(err).ToNot(HaveOccurred())
+	g.Expect(state.Definitions()).To(HaveLen(len(defs)))
+}
+
+func TestSplitOneOfResources_RefusesWhatItCannotSplit(t *testing.T) {
+	g := NewGomegaWithT(t)
+	defs, _ := splitOneOfDefinitions()
+
+	t.Setenv("ASO_GENERATOR_SPLIT_ONEOF", "group/Pet.Properties")
+	_, err := SplitOneOfResources().Run(context.TODO(), NewState(defs))
+	g.Expect(err).To(MatchError(ContainSubstring("not found")))
+
+	t.Setenv("ASO_GENERATOR_SPLIT_ONEOF", "group/Person.Name")
+	_, err = SplitOneOfResources().Run(context.TODO(), NewState(defs))
+	g.Expect(err).To(MatchError(ContainSubstring("not a named type")))
+}
