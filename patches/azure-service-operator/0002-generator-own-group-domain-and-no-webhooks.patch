+// GroupSuffix is the domain every generated group ends with: ".azure.com", or
+// the value of ASO_GENERATOR_GROUP_SUFFIX (Modified by High Five Labs, so
+// that kinds generated outside ASO live in their own groups).
+var GroupSuffix = groupSuffixFromEnvironment()
+
+func groupSuffixFromEnvironment() string {
+	if s := os.Getenv("ASO_GENERATOR_GROUP_SUFFIX"); s != "" {
+		return s
+	}
+
+	return asoGroupSuffix
+}
+
+// OwnerGroupSuffix is the domain suffix of the group of an owner. It is
+// GroupSuffix, except for the owners named in ASO_GENERATOR_EXTERNAL_OWNERS
+// (comma separated "group/Kind"): ASO's own kinds, which stay in ASO's
+// groups (Modified by High Five Labs).
+func OwnerGroupSuffix(group string, kind string) string {
+	for _, owner := range strings.Split(os.Getenv("ASO_GENERATOR_EXTERNAL_OWNERS"), ",") {
+		if strings.EqualFold(strings.TrimSpace(owner), group+"/"+kind) {
+			return asoGroupSuffix
+		}
+	}
+
+	return GroupSuffix
+}
