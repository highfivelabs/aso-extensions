 }
 
+// putSchemaParameters returns the parameters findARMResourceSchema reads the
+// PUT's body from when the path declares parameters of its own (Modified by
+// High Five Labs). Upstream uses the path's parameters instead of the PUT's,
+// so a spec that declares the path's name parameters at path level and the
+// body on the PUT (Synapse's privateLinkHubs and privateEndpointConnections,
+// 2021-06-01) loses the body and the kind's spec comes out empty ("no body
+// parameter found for PUT operation"). With ASO_GENERATOR_PATH_PARAMETERS
+// set, they are the union, the PUT's first, as the resource's name and path
+// already are ("The union is the final parameter set", above).
+func putSchemaParameters(op spec.PathItem) []spec.Parameter {
+	if os.Getenv("ASO_GENERATOR_PATH_PARAMETERS") == "" {
+		return op.Parameters
+	}
+
+	result := make([]spec.Parameter, 0, len(op.Put.Parameters)+len(op.Parameters))
+	result = append(result, op.Put.Parameters...)
+	return append(result, op.Parameters...)
+}
