+Licensed under the MIT license.
+*/
+
+// Modified by High Five Labs: a new test of putSchemaParameters.
+
+package jsonast
+
+import (
+	"testing"
+
+	"github.com/go-openapi/spec"
+	. "github.com/onsi/gomega"
+)
+
+func pathItemWithPathLevelParameters() spec.PathItem {
+	var item spec.PathItem
+	item.Parameters = []spec.Parameter{*spec.PathParam("privateLinkHubName")}
+	item.Put = spec.NewOperation("PrivateLinkHubs_CreateOrUpdate")
+	item.Put.Parameters = []spec.Parameter{*spec.BodyParam("privateLinkHubInfo", spec.RefSchema("#/definitions/PrivateLinkHub"))}
+	return item
+}
+
+func Test_putSchemaParameters_Upstream_UsesPathParameters(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_PATH_PARAMETERS", "")
+	g := NewGomegaWithT(t)
+
+	params := putSchemaParameters(pathItemWithPathLevelParameters())
+
+	g.Expect(params).To(HaveLen(1))
+	g.Expect(params[0].In).To(Equal("path"))
+}
+
+func Test_putSchemaParameters_WithPathParameters_KeepsPutBody(t *testing.T) {
+	t.Setenv("ASO_GENERATOR_PATH_PARAMETERS", "1")
+	g := NewGomegaWithT(t)
+
+	item := pathItemWithPathLevelParameters()
+	params := putSchemaParameters(item)
+
+	g.Expect(params).To(HaveLen(2))
+	g.Expect(params[0].In).To(Equal("body"))
+	g.Expect(params[0].Name).To(Equal("privateLinkHubInfo"))
+	g.Expect(params[1].In).To(Equal("path"))
+	// The PUT's own list is not changed.
+	g.Expect(item.Put.Parameters).To(HaveLen(1))
+}
