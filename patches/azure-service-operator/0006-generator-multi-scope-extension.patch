+// multiScopeURI is, when a and b are the same resource under two different
+// scopes (they differ before their last /providers/ and are the same from
+// there, parameter names aside), the extension resource URI
+// /{scope}/providers/... and true.
+func multiScopeURI(a, b string) (string, bool) {
+	const marker = "/providers/"
+	ia := strings.LastIndex(strings.ToLower(a), marker)
+	ib := strings.LastIndex(strings.ToLower(b), marker)
+	if ia < 0 || ib < 0 {
+		return "", false
+	}
+	canonical := func(s string) string {
+		return strings.ToLower(urlParameterRegex.ReplaceAllString(s, "{}"))
+	}
+	if canonical(a[ia:]) != canonical(b[ib:]) || canonical(a[:ia]) == canonical(b[:ib]) {
+		return "", false
+	}
+	// The same whichever path is seen first.
+	suffix := min(a[ia:], b[ib:])
+	return "/{scope}" + suffix, true
+}
+
+var urlParameterRegex = regexp.MustCompile(`\{.*?}`)
