# shellcheck shell=bash
#
# The live-test identity and target (docs/live-runs.md). The IDs are not in
# the tree: they come from the environment (.env.example), and sourcing this
# file fails with the name of any that is missing. None of them is a secret:
# the identity has no secret or certificate, only a federated credential
# trusting the offload VMs' Google service account (OFFLOAD_SA), with
# audience api://AzureADTokenExchange. The identity is owned outside this
# repository; agents never change it.
: "${AZURE_TENANT_ID:?AZURE_TENANT_ID is not set (the tenant of the live identity; see .env.example)}"
: "${AZURE_CLIENT_ID:?AZURE_CLIENT_ID is not set (the client ID of the live identity; see .env.example)}"
: "${AZURE_SUBSCRIPTION_ID:?AZURE_SUBSCRIPTION_ID is not set (the live subscription; see .env.example)}"
LIVE_RESOURCE_GROUP=aso-extensions-live-tests
LIVE_LOCATION=eastus2
