#
# The environment's identifiers, kept out of the tree. Copy this file to
# .env (git-ignored, never committed) and fill in the values from the
# team's environment records. Placeholders only here.
#
# Nothing loads .env automatically: export it in the shell that starts a
# live run (`set -a; . ./.env; set +a`), and pass what a VM needs on the
# offload command line (`offload run ... -- env NAME="$NAME" ...`). Fake
# runs (task check, task operator-e2e) need none of these and set their
# own fake subscription and tenant.

# The Azure sandbox subscription live runs may touch (CLAUDE.md, "Never").
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# The Microsoft Entra tenant that holds that subscription.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# The live-test identity: the app registration's client ID (federated
# credentials only, no secret; docs/live-runs.md).
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# The Google Cloud project offload VMs and the release registry live in.
GCP_PROJECT=example-project
# Offload (scripts/offload): its project, bucket and the VMs' service account.
OFFLOAD_PROJECT=example-project
OFFLOAD_BUCKET=gs://example-project-offload
OFFLOAD_SA=offload-runner@example-project.iam.gserviceaccount.com
